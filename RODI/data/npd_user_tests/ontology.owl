        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-facility</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Royalty</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A fee payable to the Government, calculated on the basis of the volume and the value of produced petroleum, at the shipping point on the production site. The fee is demanded pursuant to § 4-9, paragraph 1 of the Petroleum Act.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
