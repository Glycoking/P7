    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#label"/>
        <IRI>#AwardArea</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">APA (Awards in predefined areas) net areas. (table: apaAreaNet)</Literal>
