        <IRI>#wellboreStratumTopDepth</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Top depth [m] (column: lsuTopDepth)</Literal>
    </AnnotationAssertion>
