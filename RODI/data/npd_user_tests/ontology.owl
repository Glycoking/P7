        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">dateSyncNPD,fclBelongsToKind,fclBelongsToName,fclBelongsToS,fclCurrentOperatorName,fclDateUpdated,fclDesignLifetime,fclEwCode,fclEwDeg,fclEwMin,fclEwSec,fclFactMapUrl,fclFactPageUrl,fclFunctions,fclGeodeticDatum,fclKind,fclName,fclNpdidFacility,fclNsCode,fclNsDeg,fclNsMin,fclNsSec,fclPhase,fclStartupDate,fclSurface,fclWaterDepth (table: facility_fixed)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#comment"/>
        <IRI>#FixedFacility</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">&apos;Permanently placed facility&apos; is a generic term for all facilities that are placed on a field permanently. Floating production facilities, which in principle are mobile, come under this definition as they are meant to be permanently placed on the field. (table: facility_fixed)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
