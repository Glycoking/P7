    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#ProductionLicenceWorkObligation</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-org</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#ProductionWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A development well used for production of petroleum or of water for injection purposes.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#ProductionWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-well</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Prospect</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A possible petroleum trap with a mappable, delimited volume of rock.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#Prospect</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-geology</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#table"/>
        <IRI>#Quadrant</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">wellbore_development_all (ex)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#table"/>
        <IRI>#Quadrant</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">wellbore_exploration_all (ex)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#table"/>
        <IRI>#Quadrant</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">wellbore_shallow_all (ex)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Recovery</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">The production of petroleum, including the drilling of production wells, injection, assisted recovery, treatment and storage of petroleum for transport, and loading of petroleum for transportation by ship, as well as the construction, location, operation and use of installations used for recovery.   Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#Recovery</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-prod</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#RecoveryWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A well used for production or injection.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#RecoveryWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-well</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Refining</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">The refining of crude oil is really a distillation process. The components with different boiling points are separated in a distillation tower. When heated, the oil is converted to gas, which condenses again at different temperatures to, among others, petrol, paraffin, diesel, heating oils, coke and sulphur.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#Refining</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-prod</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Reserve</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Remaining, recoverable, saleable volumes of petroleum which the licensees have decided to recover and the authorities have given permission to recover.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#Reserve</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-prod</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#RichGas</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A mixture of wet and dry gas (methane, ethane, propane, butanes, etc.).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
