        <AnnotationProperty IRI="#definition"/>
        <IRI>#DryGas</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Almost pure methane gas, lacking water and with few heavy components.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
