    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Rig</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A derrick, essential machinery and additional equipment used when drilling for oil or gas on land or from a drilling platform at sea.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
