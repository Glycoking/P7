        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#table"/>
        <IRI>#NCSMonthlyProduction</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">field_production_totalt_NCS_month</Literal>
