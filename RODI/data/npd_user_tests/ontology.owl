    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#label"/>
        <IRI>#Pipeline</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Main pipelines. The dataset contains not infield pipelines. (table: pipLine)</Literal>
