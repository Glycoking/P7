    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#column"/>
        <IRI>#LOTMudDensity</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">wellbore_casing_and_lot.wlbLotMudDencity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#comment"/>
        <IRI>#LOTMudDensity</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A leak-off test (LOT) measures the formation&apos;s integrity by increasing the mud load to the point where the mud starts to leak into the formation. (column: wlbLotMudDencity)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#datatype"/>
