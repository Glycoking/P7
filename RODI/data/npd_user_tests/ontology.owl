        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">apaAreaGeometryEWKT,apaAreaGeometry_KML_WGS84,apaMap_no (table: apaAreaGross)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
