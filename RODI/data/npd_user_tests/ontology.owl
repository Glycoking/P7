    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#SeismicSurvey</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Seismic profiles are acquired by transmitting sound waves from a source above or in the substratum. The sound waves travel through the rock layers which reflect them up to sensors on the sea bed or at the surface, or down in a borehole. This enables an image of formations in the substratum to be formed. The seismic mapping of the Norwegian continental shelf started in 1962.  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#columns"/>
        <IRI>#SeismicSurvey</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">dateSyncNPD,sea3DKm2,seaBoatTotalKm,seaCdpTotalKm,seaCompanyReported,seaDateFinalized,seaDateStarting,seaGeographicalArea,seaGeotechnical,seaName,seaNpdidSurvey,seaPlanFromDate,seaPlanToDate,seaSampling,seaShallowDrilling,seaStatus,seaSurveyTypeMain,seaSurveyTypePart (table: seis_acquisition)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#label"/>
        <IRI>#SeismicSurvey</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Seismic Surveys (table: seis_acquisition)</Literal>
    </AnnotationAssertion>
