    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#DevelopmentWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A generic term for wells used for production of petroleum, production wells, injection wells and observation wells, and possible combinations thereof.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Well-definitions/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#DevelopmentWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Under the Resource Management Regulations, this is a common designation for wells used to produce petroleum.  The NPD assigns wellbore designations based on forms submitted by the operator. Development wells are divided into the categories production, injection and observation wells.  Source: http://www.npd.no/en/Topics/Wells/Temaartikler/Established-practice-for-well-designation/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#DevelopmentWell</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-well</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#columns"/>
        <IRI>#DevelopmentWellbore</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">dateSyncNPD,dscNpdidDiscovery,fclNpdidFacilityDrilling,fclNpdidFacilityProducing,fldNpdidField,prlNpdidProductionLicence,wlbCompletionDate,wlbCompletionYear,wlbContent,wlbContentPlanned,wlbDateUpdated,wlbDateUpdatedMax,wlbDiscovery,wlbDiscoveryWellbore,wlbDiskosWellOperator,wlbDiskosWellboreParent,wlbDiskosWellboreType,wlbDrillPermit,wlbDrillingFacility,wlbDrillingOperator,wlbDrillingOperatorGroup,wlbEntryDate,wlbEntryYear,wlbEwCode,wlbEwDeg,wlbEwDesDeg,wlbEwMin,wlbEwSec,wlbEwUtm,wlbFacilityTypeDrilling,wlbFactMapUrl,wlbFactPageUrl,wlbField,wlbFinalVerticalDepth,wlbGeodeticDatum,wlbKellyBushElevation,wlbLicensingActivity,wlbMainArea,wlbMultilateral,wlbNamePart1,wlbNamePart2,wlbNamePart3,wlbNamePart4,wlbNamePart5,wlbNamePart6,wlbNpdidWellbore,wlbNpdidWellboreReclass,wlbNsCode,wlbNsDecDeg,wlbNsDeg,wlbNsMin,wlbNsSec,wlbNsUtm,wlbPlotSymbol,wlbProductionFacility,wlbProductionLicence,wlbPurposePlanned,wlbReclassFromWellbore,wlbTotalDepth,wlbUtmZone,wlbWaterDepth,wlbWdssQcdate,wlbWell,wlbWellType,wlbWellboreName (table: wellbore_development_all)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#label"/>
        <IRI>#DevelopmentWellbore</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">Wellbore: Development (table: wellbore_development_all)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#table"/>
        <IRI>#DevelopmentWellbore</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">wellbore_development_all</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>#DevelopmentWellbore</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">http://sws.ifi.uio.no/vocab/version/20130919/npd-well</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#definition"/>
        <IRI>#Discovery</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">A petroleum deposit, or several petroleum deposits combined, discovered in the same well, and which testing, sampling or logging have shown probably contain mobile petroleum. The definition covers both commercial and technical discoveries. The discovery receives the status of a field, or becomes part of an existing field when a Plan for Development and Operation (PDO) is approved by the authorities (see Field).  Source: http://www.npd.no/en/About-us/Information-services/Dictionary/</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://sws.ifi.uio.no/vocab/sql#columns"/>
        <IRI>#Discovery</IRI>
        <Literal datatypeIRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral">cmpLongName,dateSyncNPD,dscCurrentActivityStatus,dscDateFromInclInField,dscDateUpdated,dscDateUpdatedMax,dscDiscoveryYear,dscFactMapUrl,dscFactPageUrl,dscHcType,dscName,dscNpdidDiscovery,dscOwnerKind,dscOwnerName,dscResInclInDiscoveryName,fldName,fldNpdidField,nmaName,wlbName,wlbNpdidWellbore (table: discovery)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
